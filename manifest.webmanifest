{
  "id": "./",
  "name": "Sapa Chat",
  "short_name": "Sapa",
  "description": "Sapa — messenger realtime dengan pesan pribadi, grup, status, voice note, polling, panggilan, media bersama, pesan sementara dan PWA.",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#111827",
  "theme_color": "#0f766e",
  "categories": [
    "social",
    "communication"
  ],
  "lang": "id-ID",
  "icons": [
    {
      "src": "sapa-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "sapa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "sapa-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Buka Obrolan",
      "short_name": "Obrolan",
      "url": "./?source=shortcut&tab=chats",
      "icons": [
        {
          "src": "sapa-icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Buat Percakapan",
      "short_name": "Chat Baru",
      "url": "./?source=shortcut&tab=chats&new=1",
      "icons": [
        {
          "src": "sapa-icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Buka Status",
      "short_name": "Status",
      "url": "./?source=shortcut&tab=status",
      "icons": [
        {
          "src": "sapa-icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./?share_target=1",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  }
}
